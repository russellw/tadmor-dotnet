<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore only from the committed packages in vendor/nuget (docs/stack.md,
  "Supply-chain posture"). nuget.org is never contacted; tools/vendor.py sync
  is the one step that is online, and it uses its own configuration.
-->
<configuration>
  <config>
    <!-- Extract into the repository, not ~/.nuget/packages, so nothing
         cached from other projects can stand in for a vendored package. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="vendor" value="vendor/nuget" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <auditSources>
    <clear />
  </auditSources>
</configuration>
