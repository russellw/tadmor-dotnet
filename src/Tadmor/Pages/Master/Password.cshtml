@page "/users/{id:int}/password"
@model Tadmor.Pages.Master.PasswordModel
@{
    ViewData["Title"] = "Reset password: " + Model.Email;
}
<form method="post" class="form">
    <partial name="_Error" model="Model.Error" />
    <label>New password (at least 8 characters) <input type="password" name="password" autocomplete="new-password" required></label>
    <p class="muted">Every session of this user is signed out.</p>
    <p class="actions"><button type="submit">Reset password</button> <a href="/users/@Model.Id">Cancel</a></p>
</form>
